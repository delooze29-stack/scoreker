rules_version = '2';

// ScoreKer Firestore rules.
// Paste this whole file into Firebase console → Firestore Database → Rules → Publish.
// Players: Mathew (delooze29@googlemail.com, also @gmail.com) and Gaz (claytongary@sky.com).

service cloud.firestore {
  match /databases/{database}/documents {

    function players() {
      return ['delooze29@googlemail.com', 'delooze29@gmail.com', 'claytongary@sky.com'];
    }
    function isPlayer() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in players();
    }
    // Each player's predictions are filed under their main address
    function me() {
      let e = request.auth.token.email.lower();
      return e == 'delooze29@gmail.com' ? 'delooze29@googlemail.com' : e;
    }

    // Doughty's Links golf game (delooze29-stack/Doughty-Links): members, player-made courses and the leaderboard.
    // Anyone can read and add; nobody can edit or delete. New courses and themes need no rule changes.
    match /kfl_players/{playerId} {
      allow read: if true;
      allow create: if playerId.size() <= 20
        && request.resource.data.keys().hasOnly(['n', 'k', 'd'])
        && request.resource.data.n is string && request.resource.data.n.size() > 0 && request.resource.data.n.size() <= 16
        && request.resource.data.k == request.resource.data.n.lower();
      allow update, delete: if false;
    }
    match /kfl_keys/{playerId} {
      allow get: if true;
      allow list: if false;
      allow create: if playerId.size() <= 20
        && request.resource.data.keys().hasOnly(['h'])
        && request.resource.data.h is string && request.resource.data.h.size() == 64;
      allow update, delete: if false;
    }
    match /kfl_courses/{courseId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'by', 'd', 'theme', 'n', 'par', 'data'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 30
        && request.resource.data.by is string && request.resource.data.by.size() > 0 && request.resource.data.by.size() <= 16
        && request.resource.data.theme is string && request.resource.data.theme.size() <= 10
        && request.resource.data.n is int && request.resource.data.n >= 1 && request.resource.data.n <= 18
        && request.resource.data.par is int
        && request.resource.data.data is string && request.resource.data.data.size() <= 60000;
      allow update, delete: if false;
    }
    match /kfl_rounds/{roundId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['n', 'c', 'd', 's', 'p', 'h', 'o', 'r', 'g'])
        && request.resource.data.n is string
        && request.resource.data.n.size() > 0 && request.resource.data.n.size() <= 16
        && request.resource.data.c is string
        && request.resource.data.c.matches('[a-z0-9]{1,6}|u_[A-Za-z0-9]{8,40}')
        && request.resource.data.s is int && request.resource.data.s > 0 && request.resource.data.s < 200
        && request.resource.data.p is int
        && request.resource.data.h is list && request.resource.data.h.size() <= 18;
      allow update, delete: if false;
    }

    match /weeks/{weekId} {
      function wk() { return get(/databases/$(database)/documents/weeks/$(weekId)).data; }

      // Lock times for the weekend, created once from the published fixtures
      allow read: if isPlayer();
      allow create: if isPlayer()
        && request.resource.data.keys().hasOnly(['redKickoff', 'freeLock'])
        && request.resource.data.redKickoff is timestamp
        && request.resource.data.freeLock is timestamp;
      allow update, delete: if false;

      // Main predictions (red, clearance, tie-break): hidden from the other player
      // until the red kicks off, and locked from then on
      match /preds/{email} {
        allow read: if isPlayer() && (email == me() || request.time >= wk().redKickoff);
        allow create, update: if isPlayer() && email == me() && request.time < wk().redKickoff;
        allow delete: if false;
      }

      // Free colour pick + its score: can be set or changed until the free-colour
      // games kick off, and stays hidden from the other player until then
      match /free/{email} {
        allow read: if isPlayer() && (email == me() || request.time >= wk().freeLock);
        allow create, update: if isPlayer() && email == me() && request.time < wk().freeLock
          && request.resource.data.keys().hasOnly(['colour', 'gameId', 'score', 'updatedAt']);
        allow delete: if false;
      }

      // "Locked in" flags (counts only, never scores). Readable by anyone so the
      // reminder emails (GitHub Action) can see who still needs to enter.
      match /status/{email} {
        allow read: if true;
        allow write: if isPlayer() && email == me();
      }
    }
  }
}
